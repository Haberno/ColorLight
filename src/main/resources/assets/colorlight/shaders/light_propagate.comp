#version 430

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer OpacityBuf {
    uint opacity[];
};

layout(std430, binding = 1) readonly buffer BaseBuf {
    uint baseColor[];
};

layout(std430, binding = 2) readonly buffer PrevBuf {
    uint prevColor[];
};

layout(std430, binding = 3) writeonly buffer NextBuf {
    uint nextColor[];
};

uniform ivec3 uSize;
uniform float uDecayPerOpacityUnit;

int flatIndex(ivec3 p) {
    return p.x + p.y * uSize.x + p.z * uSize.x * uSize.y;
}

vec3 unpackColor(uint c) {
    return vec3(float(c & 0xFFu), float((c >> 8) & 0xFFu), float((c >> 16) & 0xFFu)) / 255.0;
}

uint packColor(vec3 c) {
    uvec3 b = uvec3(round(clamp(c, vec3(0.0), vec3(1.0)) * 255.0));
    return b.x | (b.y << 8) | (b.z << 16);
}

vec3 samplePrev(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, uSize)))
        return vec3(0.0);
    return unpackColor(prevColor[flatIndex(p)]);
}

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(p, uSize)))
        return;

    int i = flatIndex(p);
    vec3 base = unpackColor(baseColor[i]);
    uint op = opacity[i];

    vec3 best = base;

    if (op < 15u) {
        float decay = (1.0 + float(op)) * uDecayPerOpacityUnit;

        best = max(best, samplePrev(p + ivec3( 1, 0, 0)) - vec3(decay));
        best = max(best, samplePrev(p + ivec3(-1, 0, 0)) - vec3(decay));
        best = max(best, samplePrev(p + ivec3( 0, 1, 0)) - vec3(decay));
        best = max(best, samplePrev(p + ivec3( 0,-1, 0)) - vec3(decay));
        best = max(best, samplePrev(p + ivec3( 0, 0, 1)) - vec3(decay));
        best = max(best, samplePrev(p + ivec3( 0, 0,-1)) - vec3(decay));

        best = max(best, vec3(0.0));
    }

    nextColor[i] = packColor(best);
}
