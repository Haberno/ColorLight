#version 430

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer OpacityBuf {
    uint opacity[];
};

layout(std430, binding = 1) readonly buffer ColorBuf {
    uint color[];
};

layout(std430, binding = 2) writeonly buffer SmoothBuf {
    uint smoothColor[];
};

uniform ivec3 uSize;

int flatIndex(ivec3 p) {
    return p.x + p.y * uSize.x + p.z * uSize.x * uSize.y;
}

vec3 unpackColor(uint c) {
    return vec3(float(c & 0xFFu), float((c >> 8) & 0xFFu), float((c >> 16) & 0xFFu)) / 255.0;
}

uint packColor(vec3 c) {
    uvec3 b = uvec3(round(clamp(c, vec3(0.0), vec3(1.0)) * 255.0));
    return b.x | (b.y << 8) | (b.z << 16);
}

bool inside(ivec3 p) {
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, uSize));
}

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(p, uSize)))
        return;

    int i = flatIndex(p);

    vec3 sum = vec3(0.0);
    int count = 0;

    const ivec3 offsets[7] = ivec3[7](
        ivec3( 0, 0, 0),
        ivec3( 1, 0, 0), ivec3(-1, 0, 0),
        ivec3( 0, 1, 0), ivec3( 0,-1, 0),
        ivec3( 0, 0, 1), ivec3( 0, 0,-1)
    );

    for (int k = 0; k < 7; k++) {
        ivec3 n = p + offsets[k];
        if (!inside(n))
            continue;
        int ni = flatIndex(n);
        if (opacity[ni] >= 15u)
            continue;

        sum += unpackColor(color[ni]);
        count++;
    }

    vec3 avg = (count > 0) ? (sum / float(count)) : vec3(0.0);

    vec3 result = max(avg, unpackColor(color[i]));

    smoothColor[i] = packColor(result);
}
